# Perfil activo de Spring Boot (local para Supabase/Docker local, prod para Railway)
SPRING_PROFILES_ACTIVE=local
# Puerto HTTP (Railway inyecta PORT automáticamente; en local puedes usar PORT o SERVER_PORT)
PORT=8080
SERVER_PORT=8080

# Base de datos PostgreSQL (Supabase en desarrollo o Docker Compose local)
# Ejemplo Supabase Pooler/Direct: jdbc:postgresql://db.<TU-PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
# Ejemplo Docker local: jdbc:postgresql://localhost:5432/alamano
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/alamano
SUPABASE_DB_USER=alamano
SUPABASE_DB_PASSWORD=cambia_esta_clave_db

# Seguridad JWT (usar al menos 32 caracteres aleatorios en produccion/desarrollo)
JWT_SECRET=clave_desarrollo_a_la_mano_udea_2026_cambiar_en_entorno_real_32chars
JWT_EXPIRATION_MS=86400000

# Bloqueo por intentos fallidos (HU04)
AUTH_MAX_INTENTOS_FALLIDOS=5
AUTH_BLOQUEO_MINUTOS=15

# Almacenamiento de archivos privados (local | supabase)
STORAGE_TIPO=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_FIRMA_SECRET=firma_hmac_documentos_privados_a_la_mano_cambiar_2026
STORAGE_URL_EXPIRACION_SEGUNDOS=300

# Configuracion opcional cuando STORAGE_TIPO=supabase
SUPABASE_STORAGE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_privada
SUPABASE_STORAGE_BUCKET=documentos-privados

# Pagos y Moderacion (HU13 - HU17)
# simulada (MVP offline) | paypal (PayPal Sandbox REST API v2) | wompi (esqueleto)
PAGOS_PASARELA=simulada
MODERACION_DIAS_SUSPENSION_DEFECTO=7

# PayPal Sandbox (cuando PAGOS_PASARELA=paypal; no subir secretos reales al repositorio)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8080/api/pagos/paypal/retorno
PAYPAL_CANCEL_URL=http://localhost:8080/api/pagos/paypal/cancelado
PAYPAL_TASA_CAMBIO_COP_USD=4000.00

# CORS y URL publica del backend para construir enlaces firmados de archivos
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://10.0.2.2:8081
APP_PUBLIC_BASE_URL=http://localhost:8080

# Frontend Expo (usar http://10.0.2.2:8080 para emulador Android o http://TU_IP_LAN:8080 en Expo Go fisico)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
